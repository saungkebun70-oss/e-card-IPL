{
  "name": "ecard-ipl-saung-kebun-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi Mobile Android & iOS (Capacitor) terisolasi untuk e-Card IPL Perumahan Saung Kebun",
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:android": "node scripts/prepare-assets.mjs && npx @capacitor/assets generate --android --iconBackgroundColor '#0F172A' --splashBackgroundColor '#0F172A'",
    "assets:ios": "node scripts/prepare-assets.mjs && npx @capacitor/assets generate --ios --iconBackgroundColor '#0F172A' --splashBackgroundColor '#0F172A'",
    "android:manifest": "node scripts/inject-android-manifest.mjs",
    "ios:plist": "node scripts/inject-ios-plist.mjs",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.6.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.0",
    "@capacitor/filesystem": "^7.1.2",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.6.0",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-nfc": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.0",
    "typescript": "^5.6.3"
  }
}
